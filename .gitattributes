* text=auto eol=lf

*.gif binary
*.ico binary
*.jpeg binary
*.jpg binary
*.png binary
*.zip binary

# Unified patches need a space prefix on empty context lines.
examples/value_chain_task/*.patch whitespace=-blank-at-eol
# Preserve trailing blank context at the end of a hunk as well.
examples/iequals_task/*.patch whitespace=-blank-at-eol,-blank-at-eof
examples/dotenv_task/*.patch whitespace=-blank-at-eol,-blank-at-eof
examples/artifact_effects/*.patch whitespace=-blank-at-eol,-blank-at-eof
examples/marker_roundtrip/*.patch whitespace=-blank-at-eol,-blank-at-eof
examples/ordered_records/*.patch whitespace=-blank-at-eol,-blank-at-eof
examples/partial_failure/*.patch whitespace=-blank-at-eol,-blank-at-eof
examples/input_provenance/*.patch whitespace=-blank-at-eol,-blank-at-eof
